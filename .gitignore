# === Secrets — never commit ===
# Generated Talos configs with real credentials injected
# talos/generated/
# The real secrets.yaml lives OUTSIDE this repo, at ~/.config/nature/secrets.yaml
# (see scripts/secrets-path.sh). These entries are the second layer only —
# they catch a stale pre-migration clone. Do not rely on them: .gitignore is
# overridden by `git add -f` and stops applying entirely once a file is tracked.
secrets.yaml
secrets.yaml.age
secrets.env
secrets/
*.key
*.pem
*.p12
*.pfx

# === OS / Editor ===
.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/

# === Temporary ===
*.tmp
*.bak
talos/generated/

# PXE generated/deployed assets; may include Talos machine configs
pxe/generated/
pxe/.deploy/
pxe/assets/

# === Hermes media stack ===
# The .env (NordVPN key) is generated on the remote host only; block it
# locally just in case.
hermes/.env

# Serial boot-log captures from ESP devices — contain BSSIDs and internal
# IPs; always temporary, never commit.
serial-boot*.txt

# === ESPHome (home-assistant/esphome/) ===
# secrets.yaml is matched by the global rule above; the rendered per-build
# copy and the PlatformIO build dir are listed explicitly for parity.
home-assistant/esphome/secrets.yaml
home-assistant/esphome/.esphome/

# === Direnv ===
.direnv/

# === Generated Talos configs (loaded by direnv) ===
talos/talosconfig
talos/kubeconfig

# === Terraform (oracle/ — OCI cluster infra) ===
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# Local kubeconfig for the oracle cluster (loaded by direnv)
oracle/kubeconfig.yaml
# Local terraform run artifacts
oracle/nohup.out
oracle/terraform-retry.log

# === Terraform (proxmox/ — Proxmox VE VMs) ===
# .terraform/, *.tfstate*, *.tfvars are already matched by the global rules above;
# listed explicitly for parity with oracle/.
proxmox/.terraform/
proxmox/terraform.tfstate
proxmox/terraform.tfstate.*
proxmox/terraform.tfvars
proxmox/nohup.out
