# Auto-load NordVPN credentials when entering this directory.
# Requires: direnv (brew install direnv) and yq. After placing this file, run: direnv allow
#
# Reads the NordVPN WireGuard private key from the root secrets.yaml
# (gitignored). deploy-to-hermes.sh also reads secrets.yaml directly, so
# direnv is a convenience, not a requirement.

SECRETS_FILE="${PWD}/../secrets.yaml"

if [[ -f "$SECRETS_FILE" ]]; then
    export NORDVPN_WIREGUARD_PRIVATE_KEY="$(yq -r '.nordvpn.wireguard_private_key' "$SECRETS_FILE")"
else
    echo "direnv: ../secrets.yaml not found. Add a nordvpn: stanza (see talos/secrets.yaml.template)."
fi
