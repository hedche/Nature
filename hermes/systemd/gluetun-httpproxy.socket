[Unit]
Description=LAN socket for gluetun's HTTP proxy (proxied to the localhost-only Docker publish)

[Socket]
# Bind the LAN address specifically so it cannot collide with Docker's
# 127.0.0.1:8888 publish. FreeBind lets systemd bind before the address is up.
ListenStream=10.30.1.57:8888
FreeBind=true

[Install]
WantedBy=sockets.target
