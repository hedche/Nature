# Auto-load KUBECONFIG when entering this directory.
# Requires: direnv (brew install direnv). After placing this file, run: direnv allow
#
# Points kubectl/flux at the Oracle (OCI K3s) cluster. The kubeconfig is fetched
# from the control plane during ./bootstrap.sh (it is gitignored).

KUBECONFIG="${PWD}/kubeconfig.yaml"

if [[ -f "$KUBECONFIG" ]]; then
    export KUBECONFIG
else
    echo "direnv: kubeconfig.yaml not found. Fetch it (see README) or run ./bootstrap.sh."
fi
