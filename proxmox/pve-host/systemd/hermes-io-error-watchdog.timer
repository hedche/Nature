[Unit]
Description=Poll for hermes VM (157) io-error and self-heal
Documentation=https://github.com/  # see proxmox/pve-host/README.md

[Timer]
# First check shortly after boot, then every 60s. AccuracySec keeps it cheap.
OnBootSec=90s
OnUnitActiveSec=60s
AccuracySec=10s

[Install]
WantedBy=timers.target
