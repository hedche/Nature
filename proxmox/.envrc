# Auto-load Proxmox Terraform credentials when entering this directory.
# Requires: direnv (brew install direnv) and yq. After placing this file, run: direnv allow
#
# Reads the Proxmox API token + endpoint from the root secrets.yaml (gitignored)
# and exposes them to Terraform as TF_VAR_* so the token never lands in
# terraform.tfvars. Mirrors the "reproducible from repo + secrets.yaml" convention.

SECRETS_FILE="${PWD}/../secrets.yaml"

if [[ -f "$SECRETS_FILE" ]]; then
    export TF_VAR_proxmox_api_token="$(yq -r '.proxmox.api_token' "$SECRETS_FILE")"
    export TF_VAR_proxmox_endpoint="$(yq -r '.proxmox.endpoint' "$SECRETS_FILE")"
else
    echo "direnv: ../secrets.yaml not found. Add a proxmox: stanza (see README) or set TF_VAR_proxmox_api_token manually."
fi
