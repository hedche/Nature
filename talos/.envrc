# Auto-load TALOSCONFIG when entering this directory
# Requires: direnv (brew install direnv)
# After placing this file, run: direnv allow
#
# This sets talosctl to use the generated config automatically.
# If the config doesn't exist yet, run: ./generate-configs.sh

TALOSCONFIG="${PWD}/talosconfig"

if [[ -f "$TALOSCONFIG" ]]; then
    export TALOSCONFIG
else
    echo "direnv: talosconfig not found. Run ./generate-configs.sh to generate it."
fi
