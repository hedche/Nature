# Auto-load TALOSCONFIG and KUBECONFIG when entering this directory
# Requires: direnv (brew install direnv)
# After placing this file, run: direnv allow
#
# This sets talosctl and kubectl to use the generated configs automatically.
# If the configs don't exist yet, run: ./generate-configs.sh

TALOSCONFIG="${PWD}/talosconfig"

if [[ -f "$TALOSCONFIG" ]]; then
    export TALOSCONFIG
else
    echo "direnv: talosconfig not found. Run ./generate-configs.sh to generate it."
fi

KUBECONFIG="${PWD}/kubeconfig"

if [[ -f "$KUBECONFIG" ]]; then
    export KUBECONFIG
fi
