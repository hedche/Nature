# Nature Homelab — Secrets Template
# Copy this file to ../secrets.yaml (repo root) and fill in all values.
# NEVER commit secrets.yaml to git — it is gitignored by default.
# Back up your populated secrets.yaml securely using your preferred encrypted
# password-manager export or any external secret storage you already trust.
#
# To generate new Talos secrets:
#   talosctl gen secrets -o secrets.yaml
# This will create a new secrets.yaml with all required fields.
# Then keep that file safe and never commit it.
#
# IMPORTANT: The old secrets that were in this repo have been exposed in git history.
# You MUST rotate all secrets (regenerate with `talosctl gen secrets`) before
# using these templates in production.

# === Talos Machine Secrets ===
talos:
  # Machine token — used by nodes to join the PKI
  # Generate: talosctl gen secrets
  machineToken: "YOUR_MACHINE_TOKEN_HERE"

  # Cluster bootstrap token
  # Generate: talosctl gen secrets
  clusterToken: "YOUR_CLUSTER_TOKEN_HERE"

  # Cluster ID — base64 encoded random 32 bytes
  # Generate: talosctl gen secrets
  clusterId: "YOUR_CLUSTER_ID_HERE"

  # Cluster secret — base64 encoded random 32 bytes
  # Generate: talosctl gen secrets
  clusterSecret: "YOUR_CLUSTER_SECRET_HERE"

  # Secretbox encryption key for secrets at rest
  # Generate: talosctl gen secrets
  secretboxEncryptionSecret: "YOUR_SECRETBOX_KEY_HERE"

  # === Certificate Authorities ===
  # These are generated by `talosctl gen secrets` or `talosctl gen config`.
  # If rotating, regenerate the entire CA chain.

  machineCA:
    crt: |
      YOUR_MACHINE_CA_CRT_HERE
    key: |
      YOUR_MACHINE_CA_KEY_HERE

  clusterCA:
    crt: |
      YOUR_CLUSTER_CA_CRT_HERE
    key: |
      YOUR_CLUSTER_CA_KEY_HERE

  aggregatorCA:
    crt: |
      YOUR_AGGREGATOR_CA_CRT_HERE
    key: |
      YOUR_AGGREGATOR_CA_KEY_HERE

  etcdCA:
    crt: |
      YOUR_ETCD_CA_CRT_HERE
    key: |
      YOUR_ETCD_CA_KEY_HERE

  # Service account key for token generation
  serviceAccount:
    key: |
      YOUR_SERVICE_ACCOUNT_KEY_HERE

  # Talos API client certificate (for talosconfig)
  client:
    crt: |
      YOUR_CLIENT_CRT_HERE
    key: |
      YOUR_CLIENT_KEY_HERE

# === CUPS Print Server (photon Raspberry Pi) ===
cups:
  # USB serial number of the Canon MG6100 printer.
  # Find it by running `lpstat -v` on the configured Pi, or inspect the
  # output of: lsusb -v | grep -A 5 -i canon | grep iSerial
  printerSerial: "YOUR_PRINTER_SERIAL_HERE"

  # Optional: CUPS admin password if you configure authenticated admin access.
  # The photon Pi currently uses DefaultAuthType Basic with @SYSTEM group
  # (lpadmin) for admin operations; if you want to set a specific password
  # for the pi user in CUPS, add it here. Otherwise leave blank.
  adminPassword: ""

# === Proxmox VE (node `pve`, Terraform in proxmox/) ===
proxmox:
  # API token for Terraform, in the form USER@REALM!TOKENID=UUID.
  # Create it on the node (see proxmox/README.md):
  #   pveum user token add terraform@pve terraform --privsep 0
  # The UUID is printed once; record the FULL string here (including the part
  # after '='). proxmox/.envrc exports this as TF_VAR_proxmox_api_token.
  api_token: "terraform@pve!terraform=YOUR_TOKEN_UUID_HERE"
  endpoint: "https://10.30.1.55:8006/"
  # Public key injected into every VM's cloud-init user for passwordless SSH.
  # proxmox/.envrc exports this as TF_VAR_ssh_public_key. Not secret, but kept
  # here so the VM config is a single source of truth (repo + secrets.yaml).
  ssh_public_key: "ssh-ed25519 AAAA... you@host"

# === Kubernetes Secrets ===
# Managed by scripts/secrets.sh — values stored as plaintext here,
# base64-encoded at push time when constructing K8s Secret manifests.
# Use the CLI to add secrets:
#   ./scripts/secrets.sh create <name> -n <namespace> --from-literal key=val
#
# Multi-cluster: this repo manages two clusters — `cereal` (Talos, on-prem,
# synced from ./kubernetes/flux) and `oracle` (OCI K3s, synced from ./oracle/flux).
# Add an optional `clusters: [name, ...]` list to an entry to restrict where it is
# pushed. An entry with NO `clusters` field is shared and pushed to every cluster.
#   ./scripts/secrets.sh push --cluster cereal   # shared + cereal-only entries
#   ./scripts/secrets.sh push --cluster oracle   # shared + oracle-only entries
#   ./scripts/secrets.sh push                     # everything (no filter)
kubernetes:
  secrets: []
  # Example (shared across all clusters — no `clusters` field):
  # - name: my-app-creds
  #   namespace: default
  #   type: Opaque
  #   data:
  #     username: admin
  #     password: changeme
  #
  # Example (restricted to one cluster):
  # - name: cereal-only-creds
  #   namespace: default
  #   clusters: [cereal]
  #   data:
  #     key: value
  #
  # Peanut — personal assistant integrations (cereal only).
  # Trello: https://trello.com/power-ups/admin
  # Google API key: Gemini Developer API key.
  # Gmail OAuth fields are optional unless Gmail context is enabled.
  # - name: peanut-secrets
  #   namespace: peanut
  #   type: Opaque
  #   clusters: [cereal]
  #   data:
  #     TRELLO_API_KEY: "YOUR_TRELLO_API_KEY"
  #     TRELLO_API_TOKEN: "YOUR_TRELLO_API_TOKEN"
  #     TRELLO_BOARD_ID: "YOUR_TRELLO_BOARD_ID"
  #     GOOGLE_API_KEY: "YOUR_GOOGLE_API_KEY"
  #     TELEGRAM_BOT_TOKEN: "YOUR_TELEGRAM_BOT_TOKEN"
  #     TELEGRAM_CHAT_ID: "YOUR_TELEGRAM_CHAT_ID"
  #     GMAIL_CLIENT_ID: ""
  #     GMAIL_CLIENT_SECRET: ""
  #     GMAIL_REFRESH_TOKEN: ""
  #     GMAIL_SENDER_EMAILS: ""
  #
  # Flux CD — GitHub access token for GitOps reconciliation.
  # Shared across clusters (no `clusters` field): both cereal and oracle pull the
  # same repo with the same token, so this is pushed to every cluster.
  # Generate a fine-grained PAT at https://github.com/settings/tokens
  # with Contents (read/write) + Metadata (read) on hedche/Nature.
  # - name: flux-system
  #   namespace: flux-system
  #   type: Opaque
  #   data:
  #     username: git
  #     password: ghp_YOUR_GITHUB_PAT
  #
  # Cloudflare API Token — for STRRL cloudflare-tunnel-ingress-controller (cereal only).
  # Required permissions: Zone:Zone:Read, Zone:DNS:Edit, Account:Cloudflare Tunnel:Edit
  # Generate at: https://dash.cloudflare.com/profile/api-tokens
  # Use the "Create Custom Token" template with those three permissions.
  # - name: cloudflare-api-token
  #   namespace: cloudflared
  #   type: Opaque
  #   clusters: [cereal]
  #   data:
  #     token: "YOUR_CLOUDFLARE_API_TOKEN"
  #
  # Cloudflare Account ID — found on the right sidebar of any Cloudflare dashboard page.
  # - name: cloudflare-account-id
  #   namespace: cloudflared
  #   type: Opaque
  #   clusters: [cereal]
  #   data:
  #     id: "YOUR_CLOUDFLARE_ACCOUNT_ID"

