# Auto-load Grafana Cloud Terraform credentials when entering this directory.
# Requires: direnv (brew install direnv) and yq. Then run: direnv allow
#
# Mirrors proxmox/.envrc — reads from secrets.yaml OUTSIDE the repo (Nature is
# public) and exposes values as TF_VAR_*, so no token ever lands in a .tfvars.

SECRETS_FILE="${SECRETS_FILE:-$HOME/.config/nature/secrets.yaml}"

if [[ -f "$SECRETS_FILE" ]]; then
    export TF_VAR_cloud_access_policy_token="$(yq -r '.grafana.cloud_access_policy_token // ""' "$SECRETS_FILE")"
    export TF_VAR_stack_slug="$(yq -r '.grafana.stack_slug // ""' "$SECRETS_FILE")"
    # Reuses the peanut bot — same token and chat id, no second bot to manage.
    export TF_VAR_telegram_bot_token="$(yq -r '.kubernetes.secrets[] | select(.name=="peanut-secrets") | .data.TELEGRAM_BOT_TOKEN' "$SECRETS_FILE")"
    export TF_VAR_telegram_chat_id="$(yq -r '.kubernetes.secrets[] | select(.name=="peanut-secrets") | .data.TELEGRAM_CHAT_ID' "$SECRETS_FILE")"

    if [[ -z "$TF_VAR_cloud_access_policy_token" || -z "$TF_VAR_stack_slug" ]]; then
        echo "direnv: grafana.cloud_access_policy_token / grafana.stack_slug missing from $SECRETS_FILE — see ./README.md step 2."
    fi
else
    echo "direnv: $SECRETS_FILE not found. See ./README.md."
fi
